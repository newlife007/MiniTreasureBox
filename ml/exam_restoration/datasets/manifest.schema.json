{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "records"],
  "properties": {
    "version": {"const": 1},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "template_id", "image", "label", "source_owner", "license_evidence", "permitted_uses", "retention_until", "withdrawn", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "template_id": {"type": "string", "minLength": 1},
          "image": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "source_owner": {"type": "string", "minLength": 1},
          "license_evidence": {"type": "string", "minLength": 1},
          "permitted_uses": {"type": "array", "items": {"type": "string"}},
          "retention_until": {"type": "string", "format": "date"},
          "withdrawn": {"type": "boolean"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
